# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id



# Stripe Configuration (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# N8N Integration (Desplegado en Easypanel)
# Ejemplo: https://workflows.valora.plus/webhook/23154e6f-420b-4186-be36-8b7585da797a
VITE_N8N_PDF_WORKFLOW_URL=https://workflows.valora.plus/webhook/tu-webhook-id

# Supabase Service Role (Optional for backend logic)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (extraccion de PDF)
# NO se configura aqui. La key vive como secret de la Edge Function
# 'openai-chat' para no exponerla en el bundle del navegador:
#   Dashboard > Project Settings > Edge Functions > Secrets > OPENAI_API_KEY
# El modelo esta fijado en src/services/pdfExtractionService.ts

# NOTA: SUPABASE_ACCESS_TOKEN (sbp_...) es una credencial de tu CUENTA,
# no del proyecto. No la guardes en este archivo; pasala solo como
# variable de entorno al ejecutar 'supabase functions deploy'.
